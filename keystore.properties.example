# Modelo de configuração de assinatura de release.
#
# 1. Gere a keystore (o comando está no README, seção "Build de release").
# 2. Copie este arquivo para keystore.properties na raiz do projeto.
# 3. Preencha os valores com os que você escolheu ao gerar a chave.
#
# keystore.properties e o próprio .jks estão no .gitignore e não podem ser
# commitados: quem tiver a chave de upload assina pacotes no seu nome, e
# perdê-la exige um processo de recuperação junto ao Google.

storeFile=C:/caminho/para/fps-calculadora-upload.jks
storePassword=
keyAlias=upload
keyPassword=
