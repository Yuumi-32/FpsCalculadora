<?xml version="1.0" encoding="utf-8"?>
<!--
  O adaptativo já é recortado pela máscara do launcher, então o ícone redondo
  do API 26+ é o mesmo arquivo. O ic_launcher_round.png (agora de fato redondo)
  serve só ao Android 7 e 8.0.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_mark" />
</adaptive-icon>
